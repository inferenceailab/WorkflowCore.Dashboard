<Project>
  <!-- In a .targets file so each project's own IsPackable setting is already known. -->
  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <None Include="$(MSBuildThisFileDirectory)docs/nuget/README.md" Pack="true" PackagePath="/" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)docs/images/icon.png" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>
</Project>
